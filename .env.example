# This is an example .env file.
# Copy this to .env and fill in the values for your local environment.

# --- CORE ---

# PostgreSQL Connection String (using psycopg2 driver)
DATABASE_URL="postgresql+psycopg2://user:password@localhost:5433/a_eye_db"

# Redis Connection String
REDIS_URL="redis://localhost:6380/0"

# --- STORAGE ---
# Set to 'local' to use the local filesystem for uploads, or 's3' to use S3/MinIO.
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="uploads"

# --- AWS S3 / MinIO (only required if STORAGE_TYPE is 's3') ---
S3_BUCKET_NAME="a-eye-bucket"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT_URL="http://minio:9000" # Use this for local development with MinIO